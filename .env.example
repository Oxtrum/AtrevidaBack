DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=atrevida_db
DB_SSLMODE=require
AUTH_TOKEN_SECRET=SECRET_KEY
AUTH_TOKEN_TTL_MINUTES=480

# Supabase Storage (imagenes de combos)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=paquetes

# Cloudflare Turnstile: el backend valida el captcha de las reservas publicas (siteverify).
# TURNSTILE_SECRET_KEY = secret key del MISMO widget cuya site key usa el front.
# TURNSTILE_ALLOWED_HOSTNAMES = dominios del front separados por coma, sin https:// (p. ej. atrevidafit.com,www.atrevidafit.com).
# Si falta alguno, las reservas publicas responden 503. TURNSTILE_DISABLED=true solo para desarrollo local.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_DISABLED=false

S3_BUCKET=
S3_REGION=sa-east-1

S3_PUBLIC_BASE_URL=

# Secreto del job diario de gastos fijos (POST /bd/finanzas/gastos-fijos/generar con header X-Job-Secret).
# Vacio = solo admin_sys puede ejecutarlo.
JOB_SECRET=
